{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sam123",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b87bf626-08a7-4bb9-b021-1d157f203c56","database_name": "Piki" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a82a79c5804f47ebb923a3842ab1c573" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
